{
  "permissions": {
    "allow": [
      "Bash(make test:*)",
      "Bash(make cover)",
      "Bash(make generate)",
      "Bash(go vet:*)",
      "Bash(gofmt -l:*)"
    ],
    "ask": [
      "Bash(make migrate-local:*)",
      "Bash(make release:*)",
      "Bash(make secrets:*)"
    ],
    "deny": [
      "Bash(kubectl delete:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path'); case \"$f\" in *.go) gofmt -w \"$f\";; esac; exit 0"
          }
        ]
      }
    ]
  }
}
