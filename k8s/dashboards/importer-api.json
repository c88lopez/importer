    {
      "id": 16,
      "type": "timeseries",
      "title": "Database call duration (p95)",
      "description": "query: running SQL. acquire: waiting for a free connection; if it grows, the pool is too small. connect: opening a new connection.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 8,
